  {
    "slug": "oyster",
    "model": {
      "format": "ecodynamics",
      "version": 1,
      "name": "Pacific oyster growth",
      "description": "Practical 5 · Food, metabolism and tissue/shell growth",
      "notes": "Source: Practical 5 (2024) and recovered equations from Modèle croissance organisme.STM. Expected constant-input result with Euler DT=1 month: dry mass 1.467202 g, shell mass 91.210765 g after 12 steps. This matches the rounded worksheet targets. The recovered mass exponent is 0.66; the worksheet describes 2/3. Tissue gain is a signed flow, allowing weight loss. The original worksheet does not fully specify dimensional conversions for every physiological rate; 'worksheet units' deliberately preserves this uncertainty. This is an oyster energy-balance teaching model; no reserve or reproduction compartments are included.",
      "settings": {
        "start": 0,
        "end": 12,
        "dt": 1,
        "output_every": 1,
        "method": "euler",
        "time_unit": "months"
      },
      "elements": [
        {
          "id": "température",
          "name": "température",
          "kind": "converter",
          "equation": "12",
          "x": 130,
          "y": 140,
          "unit": "°C",
          "description": ""
        },
        {
          "id": "nourriture",
          "name": "nourriture",
          "kind": "converter",
          "equation": "2.5",
          "x": 130,
          "y": 310,
          "unit": "mg POM/L",
          "description": ""
        },
        {
