          "kind": "converter",
          "equation": "ingestion*0.75",
          "x": 800,
          "y": 480,
          "unit": "worksheet units",
          "description": ""
        },
        {
          "id": "RESP",
          "name": "RESP",
          "kind": "converter",
          "equation": "(0.266*EXP(0.06*température))*(Masse_sèche^0.80)",
