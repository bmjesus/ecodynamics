          "y": 310,
          "unit": "worksheet units",
          "description": ""
        },
        {
          "id": "Pseudofèces",
          "name": "Pseudofèces",
          "kind": "converter",
          "equation": "fraction_rejetée*Consommation",
          "x": 385,
          "y": 480,
          "unit": "worksheet units",
          "description": ""
        },
        {
          "id": "ingestion",
          "name": "ingestion",
          "kind": "converter",
          "equation": "Consommation-Pseudofèces",
          "x": 600,
          "y": 480,
          "unit": "worksheet units",
          "description": ""
        },
        {
          "id": "Absorption",
