          "y": 480,
          "unit": "fraction",
          "description": ""
        },
        {
          "id": "Filtration",
          "name": "Filtration",
          "kind": "converter",
          "equation": "(0.013*(température-19)^2)*(Masse_sèche^0.66)",
          "x": 385,
          "y": 140,
          "unit": "worksheet units",
          "description": ""
        },
        {
          "id": "Consommation",
